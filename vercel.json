{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public/build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- resources/js resources/css package.json vite.config.js",
  "functions": {
    "api/**/*.php": {
      "runtime": "php:8.3"
    }
  },
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "/api/$1"
    },
    {
      "src": "^/index\\.html$",
      "status": 200,
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "^/build/.*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/.*\\.(js|css|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/.*",
      "status": 404,
      "headers": {
        "content-type": "application/json"
      }
    }
  ]
}

APP_NAME=BizHR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hr.example.com
APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Phnom_Penh

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bizhr
DB_USERNAME=bizhr
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hr@example.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Payroll statutory defaults must be reviewed against current Cambodia regulations.
PAYROLL_BASE_CURRENCY=USD
PAYROLL_USD_TO_KHR_RATE=4000

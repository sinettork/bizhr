APP_NAME=BizHR
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE_GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://hr.example.com
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL ត្រូវដាក់នៅតំបន់ជិត Laravel server
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bizhr
DB_USERNAME=bizhr
DB_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
# ប្រើ require សម្រាប់ database ពីចម្ងាយដែលបានបើក TLS
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_STORE=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ប្រើ Redis សម្រាប់ production (ត្រូវបើក PHP extension: redis)
BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_PREFIX=bizhr
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dashboard performance: use Redis for CACHE_STORE when Redis is provisioned.
BIZHR_DASHBOARD_CACHE_SECONDS=90
BIZHR_DASHBOARD_POLL_SECONDS=60

# ប្រើ S3 សម្រាប់ server ច្រើន; local អាចប្រើបានសម្រាប់ server តែមួយ
FILESYSTEM_DISK=local
FILESYSTEM_THROW=true
BIZHR_EXPORTS_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_API_KEY
MAIL_FROM_ADDRESS=noreply@bizhr.app
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Configuration (optional - for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=https://hr.example.com

# Review these statutory defaults against current Cambodia regulations.
PAYROLL_BASE_CURRENCY=USD
PAYROLL_USD_TO_KHR_RATE=4000

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=https://hr.example.com

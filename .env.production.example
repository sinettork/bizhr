APP_NAME=BizHR
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE_GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://hr.example.com
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=stderr
LOG_LEVEL=warning

# PostgreSQL production connections should use TLS.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bizhr
DB_USERNAME=bizhr
DB_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_STORE=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Redis-backed cache, sessions and queues are required for production scale-out.
BROADCAST_CONNECTION=log
CACHE_STORE=redis
CACHE_PREFIX=bizhr
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
REDIS_PORT=6379

# Dashboard performance.
BIZHR_DASHBOARD_CACHE_SECONDS=90
BIZHR_DASHBOARD_POLL_SECONDS=60

# Production uploads and exports should use persistent object storage.
FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
BIZHR_EXPORTS_DISK=s3
BIZHR_UPLOAD_SCANNER=required
BIZHR_CLAMSCAN_BINARY=clamscan
BIZHR_UPLOAD_SCAN_TIMEOUT=30

# Attendance QR must point to an HTTPS URL reachable by employee phones.
ATTENDANCE_QR_PUBLIC_URL=https://hr.example.com
ATTENDANCE_QR_LIFETIME_SECONDS=45
ATTENDANCE_QR_MIN_CHECKOUT_MINUTES=5
ATTENDANCE_QR_MAX_ACCURACY_METERS=100

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_API_KEY
MAIL_FROM_ADDRESS=noreply@bizhr.app
MAIL_FROM_NAME="${APP_NAME}"

# Persistent private object storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=https://hr.example.com

# Review these statutory defaults against current Cambodia regulations before go-live.
PAYROLL_BASE_CURRENCY=USD
PAYROLL_USD_TO_KHR_RATE=4000

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=https://hr.example.com
